# Server port
PORT=4000

# SMTP settings used to deliver messages submitted through the contact form.
# An app password works well for Gmail/Google Workspace accounts.
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=your-email@example.com
MAIL_PASS=your-email-password-or-app-password

# Where contact form submissions get delivered, and who they appear to be from.
CONTACT_TO_EMAIL=you@example.com
CONTACT_FROM_EMAIL=website-contact@example.com

# Where service-request submissions get delivered. Both fall back to the
# contact settings above if left unset.
SERVICE_REQUEST_TO_EMAIL=you@example.com
SERVICE_REQUEST_FROM_EMAIL=website-services@example.com
